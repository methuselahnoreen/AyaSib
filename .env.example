# AyaSib environment variables (example)
#
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real keys, and never paste them in chat.
# All of these are SERVER-ONLY secrets. Do not prefix any of them with NEXT_PUBLIC_.

# --- Cloudflare Workers AI (the open-source model that routes questions) ---
# Account ID: Cloudflare dashboard > Workers & AI (or the right-hand sidebar of the dashboard home).
CLOUDFLARE_ACCOUNT_ID=
# API token: Cloudflare dashboard > My Profile > API Tokens. Needs the "Workers AI" permission.
CLOUDFLARE_API_TOKEN=

# --- Optional model override ---
# Defaults to @cf/qwen/qwen3-30b-a3b-fp8 (set in backend/lib/ask.mjs) if left blank.
# Another open model to try: @cf/openai/gpt-oss-120b
LLM_MODEL=

# Note: the backend reads these from ../.env.local (see backend/package.json scripts).
# The Next.js frontend has its own example at frontend/.env.example; the deployed app
# reads CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN from the host's settings (e.g. Vercel),
# never from a committed file.
