# Server-only settings. Copy to .env.local and fill in. Never prefix these with NEXT_PUBLIC_.
# LLM_PROVIDER: "gemini" (has a free tier) or "anthropic"
LLM_PROVIDER=gemini
LLM_API_KEY=
# For gemini: a model name from your Google AI Studio account (for example one with "flash" in its name).
# For anthropic: for example claude-sonnet-5-5
LLM_MODEL=
# Optional, gemini only: backup models tried (in order) if the main one is busy or unavailable. Comma separated.
LLM_FALLBACK_MODELS=

# Photo reader (OCR). Uses Cloudflare Workers AI image-to-text. Server-only; never prefix with NEXT_PUBLIC_.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: override the vision model (defaults to @cf/mistralai/mistral-small-3.1-24b-instruct, Apache 2.0).
OCR_MODEL=

# Public GitHub repo that the "report outdated info" control files issues against.
# Format: owner/name. This is NOT a secret and is safe to commit.
# NEXT_PUBLIC_ prefix is required because the client builds the issue URL in the browser.
# If unset, the report control hides and shows a "confirm with the office" message instead.
NEXT_PUBLIC_GITHUB_REPO=methuselahnoreen/AyaSib
